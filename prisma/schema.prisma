// Prisma schema for Luxury Pyramids View Hotel
// Demo/development configuration. Production data must be provided by the hotel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  HOTEL_MANAGER
  RESERVATION_MANAGER
  RECEPTION
  CONTENT_EDITOR
  ACCOUNTANT
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REFUNDED
  FAILED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  PAYMOB
}

enum Currency {
  EGP
  USD
  EUR
  GBP
  SAR
  AED
}

enum BedType {
  KING
  QUEEN
  TWIN
  DOUBLE
  SINGLE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum OfferType {
  ROOM
  STAY
  PACKAGE
}

// ─────────────────────────────────────────────────────────────
// Staff & Roles
// ─────────────────────────────────────────────────────────────

model Staff {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(CONTENT_EDITOR)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
}

// ─────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String?
  name          String
  phone         String?
  locale        String      @default("en")
  emailVerified DateTime?
  googleId      String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bookings      Booking[]
}

// ─────────────────────────────────────────────────────────────
// Rooms
// ─────────────────────────────────────────────────────────────

model Room {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  nameAr         String?
  description    String
  descriptionAr  String?
  sizeSqm        Int
  bedType        BedType       @default(KING)
  maxGuests      Int           @default(2)
  view           String?
  image          String?
  gallery        Media[]
  pricePerNight  Decimal       @db.Decimal(10, 2)
  currency       Currency      @default(USD)
  rate           Rate?
  amenities      RoomAmenity[]
  reviews        Review[]
  bookings       BookingItem[]
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([active])
}

model Amenity {
  id        String        @id @default(cuid())
  name      String
  nameAr    String?
  icon      String?
  rooms     RoomAmenity[]
}

model RoomAmenity {
  roomId    String
  amenityId String
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity   Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

// ─────────────────────────────────────────────────────────────
// Rates
// ─────────────────────────────────────────────────────────────

model Rate {
  id             String      @id @default(cuid())
  roomId         String      @unique
  room           Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  basePrice      Decimal     @db.Decimal(10, 2)
  currency       Currency    @default(USD)
  weekendPremium Decimal     @default(0.15) @db.Decimal(4, 2)
  minStay        Int         @default(1)
  maxStay        Int?
  closedDates    ClosedDate[]
  seasonalRates  SeasonalRate[]
}

model SeasonalRate {
  id        String   @id @default(cuid())
  rateId    String
  rate      Rate     @relation(fields: [rateId], references: [id], onDelete: Cascade)
  from      DateTime
  to        DateTime
  price     Decimal  @db.Decimal(10, 2)
  currency  Currency @default(USD)

  @@index([rateId, from, to])
}

model ClosedDate {
  id        String   @id @default(cuid())
  rateId    String
  rate      Rate     @relation(fields: [rateId], references: [id], onDelete: Cascade)
  date      DateTime

  @@unique([rateId, date])
}

// ─────────────────────────────────────────────────────────────
// Offers
// ─────────────────────────────────────────────────────────────

model Offer {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  titleAr     String?
  description String
  descriptionAr String?
  type        OfferType   @default(STAY)
  image       String?
  discountPct Decimal?    @db.Decimal(5, 2)
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────
// Bookings
// ─────────────────────────────────────────────────────────────

model Booking {
  id             String         @id @default(cuid())
  bookingRef     String         @unique
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName      String
  guestEmail     String
  guestPhone     String?
  guestAddress   String?
  specialRequests String?
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  adults         Int            @default(2)
  children       Int            @default(0)
  status         BookingStatus  @default(PENDING)
  currency       Currency       @default(USD)
  subtotal       Decimal        @db.Decimal(12, 2)
  taxes          Decimal        @default(0) @db.Decimal(12, 2)
  fees           Decimal        @default(0) @db.Decimal(12, 2)
  discounts      Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  amountDue      Decimal        @db.Decimal(12, 2)
  items          BookingItem[]
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([userId])
}

model BookingItem {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  pricePerNight Decimal @db.Decimal(12, 2)
  currency    Currency @default(USD)
  quantity    Int      @default(1)

  @@index([roomId])
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id              String         @id @default(cuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider        String         @default("manual")
  providerTxId    String?
  method          PaymentMethod  @default(CARD)
  amount          Decimal        @db.Decimal(12, 2)
  currency        Currency       @default(USD)
  status          PaymentStatus  @default(PENDING)
  refunds         Refund[]
  rawProviderData Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([bookingId])
  @@index([status])
}

model Refund {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  reason     String?
  providerTxId String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  title     String?
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([roomId, approved])
}

// ─────────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────────

model Media {
  id        String    @id @default(cuid())
  url       String
  alt       String?
  kind      MediaKind @default(IMAGE)
  width     Int?
  height    Int?
  roomId    String?
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// CMS content
// ─────────────────────────────────────────────────────────────

model Page {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  titleAr      String?
  content      Json?
  metaTitle    String?
  metaDescription String?
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())
}

model SiteSetting {
  id          String @id @default(cuid())
  key         String @unique
  value       Json
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([entity, entityId])
}