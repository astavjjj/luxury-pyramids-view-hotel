# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luxury_pyramids_hotel?schema=public"

# ── Core ──────────────────────────────────────────────────
# Node environment: development | production
NODE_ENV="development"
# Base URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Session security ──────────────────────────────────────
# 32+ character random secret used to sign session tokens
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# ── Google OAuth (customer sign-in) ───────────────────────
# https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client ID, Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Redirect URI must be: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback

# ── Email ─────────────────────────────────────────────────
# console   → logs emails to the server console (development only)
# resend    → real emails via Resend (requires RESEND_API_KEY)
# smtp      → real emails via SMTP (requires SMTP_HOST/SMTP_USER/SMTP_PASS)
EMAIL_PROVIDER="console"
EMAIL_FROM="Luxury Pyramids View Hotel <no-reply@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Online payments ───────────────────────────────────────
# manual   → no online gateway; bookings are PAYMENT_PENDING until settled
# paymob   → Paymob gateway (Egypt, EGP) — requires the keys below
PAYMENT_PROVIDER="manual"
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""

# ── Media storage ─────────────────────────────────────────
# local   → stores uploads under /public/media (development / small hotels)
# s3      → stores uploads on an S3-compatible bucket (production)
MEDIA_STORAGE="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""